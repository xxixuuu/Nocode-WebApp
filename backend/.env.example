# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Database
DATABASE_URL="postgresql://zerocode:password@localhost:5432/zerocode?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=deepseek-coder:6.7b

# Docker (for sandbox)
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_NETWORK=zerocode-sandbox
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1

# MongoDB (for generated code storage)
MONGODB_URL=mongodb://localhost:27017/zerocode-code

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload
MAX_FILE_SIZE=10485760

# Security
BCRYPT_ROUNDS=10
